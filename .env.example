# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database (docker-compose service name "postgres") ---
POSTGRES_USER=hireminds
POSTGRES_PASSWORD=hireminds_dev_password
POSTGRES_DB=hireminds
DATABASE_URL=postgresql+psycopg://hireminds:hireminds_dev_password@postgres:5432/hireminds

# --- Auth ---
JWT_SECRET=change_this_to_a_long_random_string

# --- LLM provider ---
# Leave empty for now — every LLM-calling feature (resume parsing, and later
# assessment generation / interview) falls back to a non-LLM path when this
# is unset (see app/services/llm_client.py) until it's filled in during the
# testing phase.
GEMINI_API_KEY=
# Check this is still current when the key above is actually added — model
# ids/tiers shift over time.
GEMINI_MODEL=gemini-1.5-flash

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

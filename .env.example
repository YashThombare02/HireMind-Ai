# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database (docker-compose service name "postgres") ---
POSTGRES_USER=hireminds
POSTGRES_PASSWORD=hireminds_dev_password
POSTGRES_DB=hireminds
DATABASE_URL=postgresql+psycopg://hireminds:hireminds_dev_password@postgres:5432/hireminds

# --- Auth ---
JWT_SECRET=change_this_to_a_long_random_string

# --- LLM provider ---
# Leave empty for now — the backend falls back to a mock LLM client (see app/services/llm_client.py)
# until this is filled in during the testing phase.
GEMINI_API_KEY=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
